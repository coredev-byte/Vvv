# ==========================================================
# Estas variáveis NÃO vão em um arquivo .env no repositório.
# Configure-as em: Vercel → seu projeto → Settings →
# Environment Variables. Depois de salvar, refaça o deploy
# (ou clique em "Redeploy") para que a função serverless
# passe a enxergá-las.
# ==========================================================

# Obrigatória para qualquer dado real da Riot.
# Chave pessoal de https://developer.riotgames.com — funciona para
# account-v1 (Riot ID -> puuid) e val-content-v1 (catálogo de agentes/mapas).
# NÃO funciona para histórico de partidas/rank (veja README-DEPLOY.md).
# Expira a cada 24h se for do tipo "development key" — gere uma nova quando parar de funcionar.
RIOT_API_KEY=

# Shard/plataforma para val-match-v1 e val-content-v1: na, eu, ap, kr, latam, br
RIOT_PLATFORM_SHARD=na

# Opcional: habilita a análise de IA real (Claude). Sem ela, o dashboard
# ainda funciona com as métricas calculadas, só sem o bloco de análise.
ANTHROPIC_API_KEY=

# Opcional: fallback NÃO OFICIAL para histórico de partidas enquanto você não
# tem chave de produção da Riot. Leia HenrikDevAdapter/README antes de ativar.
HENRIKDEV_ENABLED=false
HENRIKDEV_API_KEY=
